{
  "name": "kahoo",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint public/assets/js tests/*.test.mjs eslint.config.js",
    "format": "prettier --write public/assets/js tests/*.test.mjs eslint.config.js *.json *.yaml .pre-commit-config.yaml .github/workflows/*.yml",
    "format:check": "prettier --check public/assets/js tests/*.test.mjs eslint.config.js *.json *.yaml .pre-commit-config.yaml .github/workflows/*.yml",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9"
  }
}
