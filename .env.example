POSTGRES_DB=kahoo
POSTGRES_USER=kahoo
POSTGRES_PASSWORD=kahoo
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
KAHOO_HOST=0.0.0.0
KAHOO_PORT=4173
KAHOO_ADMIN_TOKEN=

# Meta Business Discovery
META_GRAPH_VERSION=v26.0
META_IG_USER_ID=
META_ACCESS_TOKEN=

# OpenAI-compatible 1024-dimensional embedding endpoint
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# Optional TEI multilingual reranker; configured failures stop search.
RERANK_API_URL=
RERANK_MIN_SCORE=0.2

# Vision model with image inputs and JSON mode (full /v1/chat/completions URL).
# Leave URL/model empty to queue products without making model requests.
PRODUCT_VISION_API_URL=
PRODUCT_VISION_API_KEY=
PRODUCT_VISION_MODEL=
PRODUCT_VISION_TIMEOUT=90
PRODUCT_VISION_MAX_IMAGES=8
